# Local development (explicit synthetic demo only). Start PostgreSQL with scripts/dev_db.sh start.
DATABASE_URL=postgresql+psycopg://127.0.0.1:54417/nextrm
ENVIRONMENT=development
API_INTERNAL_URL=http://127.0.0.1:8000
NEXTRM_DEMO_MODE=true
# Production requires ENVIRONMENT=production, AUTH_PROVIDER=firebase,
# PostgreSQL DATABASE_URL from a pinned Secret Manager version, and
# NEXTRM_DEMO_MODE=false. FIREBASE_WEB_API_KEY is public web config.

# Firebase public web configuration (not Admin credentials):
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project
# POC customer deployment: NEXTRM_DEMO_MODE=false, AUTH_PROVIDER=firebase
# Operator CLI uses application-default credentials. Never place service keys in web configuration.
